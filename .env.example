# Copy to .env for local development: cp .env.example .env
# Never commit .env. Production values live only in Render's environment settings.

# Local PostgreSQL 18 (docker compose up)
POSTGRES_DB=hygiene
POSTGRES_USER=hygiene
POSTGRES_PASSWORD=change-me-local-only

# How the API connects. Locally these match the values above; in production they point at Neon:
# SPRING_DATASOURCE_URL=jdbc:postgresql://<neon-host>/neondb?sslmode=require
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/hygiene
SPRING_DATASOURCE_USERNAME=hygiene
SPRING_DATASOURCE_PASSWORD=change-me-local-only

# Signing key for the API's JWTs: at least 32 characters, or the API refuses to start.
# Local placeholder only; production uses a long random value (openssl rand -base64 32).
JWT_SECRET=change-me-local-only-at-least-32-characters

# Sign-in providers (optional locally; sign-in returns 503 until they're set).
# Client secrets go here or in Render, never in the app's .env.
GOOGLE_CLIENT_IDS=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
