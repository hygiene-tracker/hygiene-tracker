# Local API from `docker compose up`. The Render static site sets its own value to the hosted API.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your-android-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GITHUB_CLIENT_ID=your-github-oauth-client-id
# Optional: set this to the exact callback registered in the GitHub OAuth App.
# Local web example: http://localhost:8081/auth
EXPO_PUBLIC_GITHUB_REDIRECT_URI=
