# Google OAuth client IDs accepted by the API, separated by commas.
GOOGLE_CLIENT_IDS=your-google-web-client-id.apps.googleusercontent.com,your-google-android-client-id.apps.googleusercontent.com

# At least 32 characters. Use a strong, private value in api/.env or your deployment secret store.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# Must match the password assigned to the local PostgreSQL role `hygiene`.
SPRING_DATASOURCE_PASSWORD=replace-with-your-local-database-password

# Copy this file to .env and fill in the values from your GitHub OAuth App.
GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret
